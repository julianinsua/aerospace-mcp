{
  "name": "aerospace-mcp",
  "version": "0.1.1",
  "description": "MCP server that lets AI agents control the AeroSpace tiling window manager on macOS",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "aerospace",
    "window-manager",
    "macos"
  ],
  "license": "MIT",
  "author": "Julian Insua",
  "homepage": "https://github.com/julianinsua/aerospace-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julianinsua/aerospace-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/julianinsua/aerospace-mcp/issues"
  },
  "type": "module",
  "bin": {
    "aerospace-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "os": [
    "darwin"
  ],
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "check": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "format": "biome format --write .",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
